{
    "name": "inpsyde/dbal",
    "description": "Database abstraction layer for WordPress, on top of wpdb and dbDelta.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Syde",
            "homepage": "https://syde.com",
            "role": "company"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/inpsyde/wp-stubs/main",
            "only": [
                "inpsyde/wp-stubs-versions"
            ]
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "syde/phpcs": "~1.0.1",
        "phpunit/phpunit": "^9.6.17",
        "brain/monkey": "^2.6.1",
        "roots/wordpress-no-content": ">=6.7",
        "inpsyde/wp-stubs-versions": "dev-latest",
        "phpstan/phpstan": "^2.1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0.1",
        "phpstan/phpstan-mockery": "^2.0.0",
        "phpstan/phpstan-phpunit": "^2.0.4",
        "swissspidy/phpstan-no-private": "^v1.0.0",
        "globalis/wp-cli-bin": "^2.8.1",
        "symfony/process": "^v5.4.36",
        "symfony/dotenv": "^v5.4.36"
    },
    "autoload": {
        "psr-4": {
            "Inpsyde\\Dbal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inpsyde\\Dbal\\Tests\\": "tests/src/",
            "Inpsyde\\Dbal\\Tests\\Unit\\": "tests/unit/",
            "Inpsyde\\Dbal\\Tests\\Integration\\": "tests/integration/"
        },
        "classmap": [
            "tests/fixtures/"
        ]
    },
    "scripts": {
        "cs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "tests:unit:cov": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit",
        "tests:unit": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit --no-coverage",
        "tests:integration": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=integration --no-coverage",
        "tests": [
            "@tests:integration",
            "@tests:unit"
        ],
        "tests:cov": [
            "@tests:integration",
            "@tests:unit:cov"
        ],
        "qa": [
            "@tests:unit",
            "@cs"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress"
    }
}

{
    "name": "inpsyde/dbal",
    "description": "Database abstraction layer for WordPress, on top of wpdb and dbDelta.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
		{
            "name": "Inpsyde",
            "homepage": "https://inpsyde.com",
			"role": "company"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/inpsyde/wp-stubs/main",
            "only": [
                "inpsyde/wp-stubs-versions"
            ]
        }
    ],
    "require": {
        "php": ">=7.4 < 8.4",
        "ext-json": "*"
    },
    "require-dev": {
        "inpsyde/php-coding-standards": "^2@dev",
        "phpunit/phpunit": "^9.6.17",
        "brain/monkey": "^2.6.1",
        "roots/wordpress-no-content": ">=6.4.3",
        "vimeo/psalm": "^5.23.0",
        "inpsyde/wp-stubs-versions": "dev-latest",
        "globalis/wp-cli-bin": "^2.8.1",
        "symfony/process": "^v5.4.36",
        "symfony/dotenv": "^v5.4.36"
    },
    "autoload": {
        "psr-4": {
            "Inpsyde\\Dbal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inpsyde\\Dbal\\Tests\\": "tests/src/",
            "Inpsyde\\Dbal\\Tests\\Unit\\": "tests/unit/",
            "Inpsyde\\Dbal\\Tests\\Integration\\": "tests/integration/"
        },
        "classmap": [
            "tests/fixtures/"
        ]
    },
    "scripts": {
        "cs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "psalm": "@php ./vendor/vimeo/psalm/psalm --no-cache --no-diff --find-unused-psalm-suppress --output-format=compact",
        "tests:unit:cov": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit",
        "tests:unit": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=unit --no-coverage",
        "tests:integration": "@php ./vendor/phpunit/phpunit/phpunit --testsuite=integration --no-coverage",
        "tests": [
            "@tests:integration",
            "@tests:unit"
        ],
        "tests:cov": [
            "@tests:integration",
            "@tests:unit:cov"
        ],
        "qa": [
            "@tests:unit",
            "@cs",
            "@psalm"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress"
    }
}

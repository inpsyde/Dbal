<?xml version="1.0"?>
<ruleset>
    <file>./src/</file>
    <file>./tests/src/</file>

	<arg value="sp"/>
	<arg name="colors"/>
	<config name="testVersion" value="7.2-"/>

    <rule ref="Inpsyde">
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize" />
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize" />
        <exclude name="WordPress.DB.PreparedSQL" />
        <exclude name="WordPress.DB.PreparedSQLPlaceholders" />
    </rule>

    <rule ref="Inpsyde.CodeQuality.Psr4">
        <properties>
            <property
                    name="psr4"
                    type="array"
                    value="Inpsyde\Dbal=>src,Inpsyde\Dbal\Tests=>tests/src,Inpsyde\Dbal\Tests\Unit=>tests/unit,Inpsyde\Dbal\Tests\Integration=>tests/integration"/>
        </properties>
    </rule>

    <rule ref="Inpsyde.CodeQuality.ElementNameMinimalLength">
        <properties>
            <property name="additionalAllowedNames" type="array" value="eq" />
        </properties>
    </rule>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" type="integer" value="20" />
        </properties>
    </rule>
</ruleset>
